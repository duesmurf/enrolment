# Path to your OAuth2 credentials JSON file downloaded from Google Cloud Console
GOOGLE_CREDENTIALS_PATH=credentials/credentials.json

# Gmail search query to find enrolment emails
GMAIL_SEARCH_QUERY=subject:enrolment has:attachment

# Google Drive settings (use --drive flag to fetch from Drive instead of Gmail)
# Folder ID from URL: https://drive.google.com/drive/folders/YOUR_FOLDER_ID
DRIVE_FOLDER_ID=
# Search query for finding files in Drive by name
DRIVE_SEARCH_QUERY=enrolment
# Folder ID to upload output files to (use --upload-drive flag)
# Leave empty to upload to Drive root
DRIVE_OUTPUT_FOLDER_ID=

# Maximum number of students per course
MAX_STUDENTS_PER_COURSE=5

# Output directory for generated placement files
OUTPUT_DIR=output

# Available courses (comma-separated)
COURSES=Engineering,Design,Sports,IT Systems,Tourism
